<style>
  section {
    padding: 10%;
  }

  .cards {
    display: grid;
    gap: 2rem;
    /* grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); */
    grid-template-columns: 1fr 1fr 1fr;

    padding-top: 2rem;
  }
</style>
