---
import { Image } from "astro:assets";

import instalogo from "../assets/insta-logo.svg";

const { text } = Astro.props;
---

<article>
  <div class="text-box">
    <p class="quote">{text}</p>
  </div>
  <div class="insta">
    <Image class="logo" src={instalogo} alt="instagram logo" />
    <a href="https://www.instagram.com/raadgivningenorfeus/?hl=da"
      >raadgivningenorfeus</a
    >
  </div>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    justify-self: center;
  }

  .text-box {
    background-color: #cddacf;
    display: flex;
    align-items: center;
    width: 400px;
    height: 400px;
    padding-inline: 40px;
    margin-bottom: 10px;
  }

  p {
    font-family: "lexend-deca", sans-serif;
    font-size: 2.25rem;
    line-height: 130%;

    color: #2c2e30;
  }

  .insta {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: end;
  }

  .logo {
    height: 20px;
  }

  a {
    color: #2c2e30;
  }
</style>
